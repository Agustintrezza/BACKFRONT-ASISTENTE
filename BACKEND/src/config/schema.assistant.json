{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AssistantConfig",
    "type": "object",
    "properties": {
      "features": {
        "type": "object",
        "properties": {
          "useConfigForMenu": { "type": "boolean" }
        },
        "additionalProperties": true
      },
      "branding": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "logoUrl": { "type": "string" },
          "colors": {
            "type": "object",
            "properties": {
              "primary": { "type": "string" },
              "secondary": { "type": "string" }
            },
            "required": ["primary", "secondary"],
            "additionalProperties": true
          }
        },
        "required": ["name", "colors"],
        "additionalProperties": true
      },
      "menu": {
        "type": "array",
        "items": { "type": "object" }
      }
    },
    "required": ["branding"],
    "additionalProperties": true
  }
  